# Server Go; RSVP tetap bekerja tanpa konfigurasi email.
PORT=8080
RSVP_STORAGE_PATH=data/rsvps.json
ALLOWED_ORIGIN=http://localhost:3000
RATE_LIMIT_RPM=10

# Opsional: isi ketiganya untuk mengaktifkan notifikasi Resend.
# EMAIL_FROM harus menggunakan pengirim yang diizinkan pada akun Anda.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=
